{
  "name": "tuilens",
  "version": "0.4.0",
  "description": "Terminal automation for AI agents with PTY sessions, image-aware capture, visual testing, performance regression baselines and MCP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blackn-L/TuiLens.git"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/src/",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "docs/*.md",
    "docs/zh-CN/*.md",
    "docs/assets/"
  ],
  "bin": {
    "tuilens": "dist/src/interfaces/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "prepublishOnly": "npm run build",
    "benchmark:overhead": "npm run build && node dist/scripts/benchmark-overhead.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xterm/addon-image": "0.9.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "playwright": "1.65.0",
    "pngjs": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
